---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = await getCollection("projects");
const notes = await getCollection("notes");
const featuredProject = projects.sort((a, b) => a.data.number.localeCompare(b.data.number))[0];
const latestNote = notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<BaseLayout>
  <section class="hero-section">
    <p class="kicker">Independent building · 2026-</p>
    <h1>Small things<br />I build.</h1>
    <p class="hero-copy">
      Tiny tools, experiments, and useful software made with curiosity.
    </p>
    <a class="text-link" href="#projects">Meet the first build</a>
  </section>

  <section class="section-band" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <span>01</span>
      <h2 id="projects-title">Projects</h2>
    </div>
    {
      featuredProject && (
        <article class="project-row">
          <div class="project-number">{featuredProject.data.number}</div>
          <div>
            <p class="status">{featuredProject.data.status}</p>
            <h3>{featuredProject.data.title}</h3>
            <p>{featuredProject.data.description}</p>
            <div class="meta-line">
              <span>{featuredProject.data.category}</span>
              {featuredProject.data.platform && <span>{featuredProject.data.platform}</span>}
              {featuredProject.data.openSource && <span>Open Source</span>}
            </div>
          </div>
        </article>
      )
    }
    <a class="text-link" href="/projects/">View project index</a>
  </section>

  <section class="section-band" aria-labelledby="notes-title">
    <div class="section-heading">
      <span>02</span>
      <h2 id="notes-title">Notes</h2>
    </div>
    <div class="note-preview">
      <p>Build notes: what I made, what broke, and what I learned.</p>
      {latestNote && <a class="text-link" href={`/notes/${latestNote.slug}/`}>Read {latestNote.data.day}: {latestNote.data.project}</a>}
    </div>
  </section>

  <section class="section-band" aria-labelledby="about-title">
    <div class="section-heading">
      <span>03</span>
      <h2 id="about-title">About</h2>
    </div>
    <p class="wide-copy">
      Pooya Works is a growing collection of small software projects and experiments. The rule is simple:
      make something useful, publish it, learn from it, and keep going.
    </p>
  </section>
</BaseLayout>
