---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Pooya Works.">
  <section class="page-intro">
    <p class="kicker">About</p>
    <h1>Pooya Works is an independent maker's workshop.</h1>
    <p>
      It is a place for small tools, experiments, and practical software built in public.
    </p>
  </section>

  <section class="section-band">
    <p class="wide-copy">
      The priority is not to look like a company. It is to build useful things consistently,
      publish working projects, document the process, and notice what people actually care about.
    </p>
  </section>
</BaseLayout>
