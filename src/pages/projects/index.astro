---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.number.localeCompare(b.data.number));
---

<BaseLayout title="Projects" description="A growing collection of Pooya Works projects.">
  <section class="page-intro">
    <p class="kicker">Project index</p>
    <h1>Useful small builds, collected as they ship.</h1>
  </section>

  <section class="list-stack" aria-label="Projects">
    {projects.map((project) => (
      <article class="project-row">
        <div class="project-number">{project.data.number}</div>
        <div>
          <p class="status">{project.data.status}</p>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
          <div class="meta-line">
            <span>{project.data.category}</span>
            {project.data.platform && <span>{project.data.platform}</span>}
            {project.data.openSource && <span>Open Source</span>}
          </div>
          {project.data.github && <a class="text-link" href={project.data.github}>GitHub repository</a>}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
